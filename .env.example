OPENAI_API_KEY=

# Model for every model call in the agent: <provider>:<model>, provider one of
# openai, anthropic, google. Set the matching key (ANTHROPIC_API_KEY or
# GOOGLE_API_KEY) for a non-OpenAI provider. For an OpenAI-compatible
# provider use openai:<its model id> and set OPENAI_BASE_URL.
COPILOTKIT_AGENT_MODEL=openai:gpt-6-luna
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_BASE_URL=

# --- CopilotKit Intelligence (optional; set CPK_INTELLIGENCE_API_KEY to enable Threads — server + UI) ---
# COPILOTKIT_LICENSE_TOKEN= # self-hosted/offline only
# INTELLIGENCE_API_URL and INTELLIGENCE_GATEWAY_WS_URL point at a self-hosted
# or local Intelligence deployment only — leave them unset when using managed
# Intelligence, or the channel host and runtime will try to reach a local
# stack that usually is not running.
# INTELLIGENCE_API_URL=http://localhost:4204
# INTELLIGENCE_GATEWAY_WS_URL=ws://localhost:4404
# CPK_INTELLIGENCE_API_KEY=

# New AMO AI Dashboard Supabase project (not the old AMO website)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# For Google OAuth, allow http://localhost:3001/auth/callback in Supabase Auth redirects.

# Turn on after Google OAuth is enabled in this new Supabase project
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Optional secure PostgreSQL Mastra storage ---
# Default is OFF; existing local in-memory storage stays unchanged.
# Enable ONLY after Supabase initialization and verified TLS connectivity
# and signed-in end-to-end chat tests with an approved deployment plan.
MASTRA_PG_ENABLED=false
# POSTGRES_URL=    # server-only Vercel Supabase integration
# MASTRA_PG_CA_CERT_B64=  # base64 of CA downloaded from Supabase Database SSL settings
# NEVER set NODE_TLS_REJECT_UNAUTHORIZED=0 or disable certificate validation.
